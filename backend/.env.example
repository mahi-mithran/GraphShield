# GraphShield Environment Configuration
# Project: SIH26199 Team GraphSentinelz

# Backend Settings
APP_NAME=GraphShield Fraud Detection API
ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database (Default: SQLite for zero-setup local execution)
# To use MySQL instead: mysql+pymysql://user:password@localhost:3306/graphshield
DATABASE_URL=sqlite:///./backend/data/processed/graphshield.db

# 3-Tier Risk Score Thresholds (MANDATORY EXACT LABELS)
# risk_score >= RISK_THRESHOLD_FRAUD               -> "FRAUD"
# RISK_THRESHOLD_MID <= risk_score < FRAUD         -> "MID_LEVEL"
# risk_score < RISK_THRESHOLD_MID                 -> "GENUINE"
RISK_THRESHOLD_FRAUD=0.70
RISK_THRESHOLD_MID=0.30

# File Paths
DATASET_CSV_PATH=./backend/data/processed/transactions_labeled.csv
MODEL_CHECKPOINT_PATH=./backend/data/processed/fraud_graphsage.pt
MODEL_METADATA_PATH=./backend/data/processed/model_metadata.json

# CORS
CORS_ORIGINS=["*"]
